---
import { site } from '@data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

/** Hand-drawn 1.5px stroke marks; no icon library. */
const icons: Record<string, string> = {
  email:
    '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 6.5 12 13l8.5-6.5"/>',
  instagram:
    '<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.6" cy="7.4" r="0.9" fill="currentColor" stroke="none"/>',
  bluesky:
    '<path d="M12 10.2C10.9 7.6 8.2 4.9 5.9 4.5 4.5 4.3 3.5 5 3.5 6.8c0 2.5 1.2 6 2.8 6.9-1 .3-1.7 1-1.2 2.3.8 2 3.2 3.6 4.7 3.5 1.3-.1 2-1.6 2.2-2.6.2 1 .9 2.5 2.2 2.6 1.5.1 3.9-1.5 4.7-3.5.5-1.3-.2-2-1.2-2.3 1.6-.9 2.8-4.4 2.8-6.9 0-1.8-1-2.5-2.4-2.3-2.3.4-5 3.1-6.1 5.7Z"/>',
};
---

<ul class:list={['social-links', className]} role="list">
  {
    site.socials.map((s) => (
      <li>
        <a href={s.href} aria-label={s.label} {...(s.platform !== 'email' ? { rel: 'me noopener', target: '_blank' } : {})}>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons[s.platform]}
          />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .social-links a {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    color: var(--text-2);
    border: 1px solid transparent;
    transition:
      color var(--dur-quick) var(--ease-out),
      border-color var(--dur-quick) var(--ease-out),
      transform 100ms ease-out;
  }

  .social-links a:hover {
    color: var(--accent-bright);
    border-color: var(--line-strong);
  }

  .social-links a:active {
    transform: scale(0.94);
  }
</style>
