---
import { site } from '@data/site';
import NewsletterForm from '@components/contact/NewsletterForm.astro';
import SocialLinks from '@components/shared/SocialLinks.astro';
import Ink from '@components/shared/Ink.astro';
import Logo from '@components/shared/Logo.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer surface-wine">
  <div class="footer-sky" aria-hidden="true"></div>

  <div class="container footer-mission">
    <Logo size={54} cloud />
    <!-- Her footer line, in her hand. The pen writes it when you arrive. -->
    <Ink piece="mission-footer" write="view" class="mission-ink" />
  </div>

  <div class="container footer-grid">
    <div class="footer-signup">
      <p class="signup-prompt">{site.newsletterPrompt}</p>
      <NewsletterForm />
    </div>

    <div class="footer-meta">
      <nav class="ui footer-nav" aria-label="Footer">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
      <SocialLinks />
    </div>
  </div>

  <div class="container footer-close">
    <p class="colophon ui">&copy; {year} Viviana Acosta</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-base);
    margin-block-start: var(--space-10);
    padding-block: var(--space-9) var(--space-6);
    overflow: clip;
  }

  /* A wine night sky: rose clouds and a few stars, drifting very slowly. */
  .footer-sky {
    position: absolute;
    inset: -6%;
    background-image: image-set(
      url('/washes/wash-wine.webp') type('image/webp'),
      url('/washes/wash-wine.jpg') type('image/jpeg')
    );
    background-size: cover;
    background-position: center;
    opacity: 0.9;
  }

  .site-footer > .container {
    position: relative;
  }

  .footer-mission {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    margin-block-end: var(--space-8);
  }

  .mission-ink {
    width: min(34rem, 100%);
  }

  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-7);
    align-items: flex-end;
    padding-block-start: var(--space-7);
    border-top: 1px solid var(--line);
  }

  .footer-signup {
    max-width: 26rem;
  }

  .signup-prompt {
    font-weight: 560;
    margin-block-end: var(--space-4);
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-4);
  }

  .footer-nav {
    display: flex;
    gap: var(--space-5);
    font-size: 0.9rem;
  }

  .footer-nav a {
    color: var(--text-2);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--text-1);
  }

  .footer-close {
    margin-block-start: var(--space-7);
  }

  .colophon {
    font-size: 0.8rem;
    color: var(--text-3);
  }

  @media (max-width: 720px) {
    .footer-meta {
      align-items: flex-start;
    }
  }
</style>
