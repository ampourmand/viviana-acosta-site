---
import { site } from '@data/site';
import Logo from '@components/shared/Logo.astro';
// Build output uses trailing-slash pathnames; normalize before comparing.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
// The section links ride along on the Writing sub-pages. The Writing page
// itself is the bookshelf, whose shelf labels already lead to each section.
const onWritingSection = path.startsWith('/writing/');
---

<header class="site-header" data-header>
  <div class="header-inner container">
    <a class="wordmark" href="/" aria-label="Viviana Acosta, home" data-wordmark>
      <span class="mark" data-logo-mark><Logo size={30} /></span>
      <span class="name">Viviana Acosta</span>
    </a>

    <nav class="site-nav ui" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            class="nav-link"
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      class="menu-button ui"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-button
    >
      <span class="menu-label" data-menu-label>Menu</span>
    </button>
  </div>

  <div class="edge-fade" aria-hidden="true"></div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav class="ui" aria-label="Primary, mobile">
      {
        site.nav.map((item) => (
          <a
            class="mobile-link t-2"
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

{
  onWritingSection && (
    <nav class="writing-subnav ui container" aria-label="Writing sections">
      {site.writingNav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  )
}

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(var(--header-blur)) saturate(150%);
    backdrop-filter: blur(var(--header-blur)) saturate(150%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-1);
  }

  .wordmark:hover {
    color: var(--text-1);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 460;
    font-variation-settings: 'SOFT' 30, 'WONK' 0;
    font-size: 1.22rem;
    letter-spacing: -0.012em;
  }

  /* The little rocket leans into a hover, and settles back. */
  .mark {
    display: block;
    transition: transform 320ms cubic-bezier(0.23, 1, 0.32, 1);
    transform-origin: 40% 70%;
  }

  .wordmark:hover .mark {
    transform: translate(1.5px, -2px) rotate(-6deg);
  }

  .wordmark:active .mark {
    transform: translate(0, 1px) scale(0.94);
    transition-duration: 90ms;
  }

  .site-nav {
    display: flex;
    gap: var(--space-5);
    font-size: 0.92rem;
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    color: var(--text-2);
    padding-block: 0.45rem;
  }

  .nav-link:hover {
    color: var(--text-1);
  }

  .nav-link[aria-current='page'] {
    color: var(--accent);
  }

  /* The current page is underlined by hand: one inked swash. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: -6%;
    right: -6%;
    bottom: -0.2rem;
    height: 0.55rem;
    background: var(--accent);
    -webkit-mask: url('/ink/swash.svg') center / 100% 100% no-repeat;
    mask: url('/ink/swash.svg') center / 100% 100% no-repeat;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 380ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .nav-link[aria-current='page']::after,
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link:hover:not([aria-current='page'])::after {
    background: var(--ornament);
  }

  /* Scroll edge effect: a soft fade where content meets the chrome,
     instead of a hard 1px divider. */
  .edge-fade {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: 14px;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(var(--shadow-color) / 0.07), transparent);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  :global([data-header].scrolled) .edge-fade {
    opacity: 1;
  }

  .menu-button {
    display: none;
    color: var(--text-2);
    font-size: 0.9rem;
    padding: 0.4rem 0.2rem;
  }

  .mobile-nav {
    background: var(--surface-2);
    border-top: 1px solid var(--line);
  }

  .mobile-nav nav {
    display: flex;
    flex-direction: column;
    padding: var(--space-5) var(--gutter) var(--space-6);
    gap: var(--space-4);
  }

  .mobile-link {
    text-decoration: none;
    color: var(--text-1);
  }

  .mobile-link[aria-current='page'] {
    color: var(--accent);
  }

  .writing-subnav {
    position: relative;
    z-index: var(--z-base);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-5);
    padding-block: var(--space-4);
    font-size: 0.85rem;
  }

  .writing-subnav a {
    text-decoration: none;
    color: var(--text-3);
  }

  .writing-subnav a:hover {
    color: var(--text-1);
  }

  .writing-subnav a[aria-current='page'] {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .site-nav {
      display: none;
    }
    .menu-button {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark,
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  import { registerModule } from '@lib/transitions/vt';

  registerModule({
    init() {
      const header = document.querySelector<HTMLElement>('[data-header]');
      const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');
      if (!header) return;

      const onScroll = () => {
        header.classList.toggle('scrolled', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      let toggle: (() => void) | undefined;
      if (button && panel) {
        toggle = () => {
          const open = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', String(!open));
          button.querySelector('[data-menu-label]')!.textContent = open ? 'Menu' : 'Close';
          panel.hidden = open;
        };
        button.addEventListener('click', toggle);
      }

      return () => {
        window.removeEventListener('scroll', onScroll);
        if (button && toggle) button.removeEventListener('click', toggle);
      };
    },
  });
</script>
