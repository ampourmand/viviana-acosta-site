---
/**
 * The signature ink intro overlay. Rendered on the home page only; the
 * intro-gate script decides whether it plays (first visit per session)
 * or is removed before paint.
 */
import SignatureSvg from './SignatureSvg.astro';
import { site } from '@data/site';
---

<div
  class="sig-overlay"
  data-sig-overlay
  data-state="idle"
  role="dialog"
  aria-modal="true"
  aria-label="Viviana Acosta signature introduction"
  hidden
>
  <div class="sig-bg" data-sig-bg aria-hidden="true"></div>
  <button class="sig-skip ui" type="button" data-sig-skip>Skip</button>

  <div class="sig-stage" data-sig-stage>
    <div class="sig-camera" data-sig-camera>
      <SignatureSvg variant="animated" idPrefix="intro" class="sig-art" />
    </div>

    <p class="sig-subtitle" data-sig-subtitle>
      {site.taglineA}
    </p>

    <button class="sig-prompt ui" type="button" data-sig-enter>
      Enter
      <span class="prompt-line" aria-hidden="true"></span>
    </button>
  </div>
</div>

<style>
  .sig-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: grid;
    place-items: center;
  }

  .sig-bg {
    position: absolute;
    inset: 0;
    background: var(--ink-950);
  }

  .sig-stage {
    width: min(920px, 86vw);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .sig-camera {
    width: 100%;
    will-change: transform;
    transform-origin: 0 0;
  }

  .sig-subtitle {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.3rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--text-2);
    opacity: 0;
  }

  .sig-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    color: var(--gold);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0;
    padding: var(--space-3) var(--space-5);
  }

  .sig-prompt:hover {
    color: var(--gold-bright);
  }

  .prompt-line {
    width: 1px;
    height: 2.2rem;
    background: var(--line-strong);
  }

  .sig-skip {
    position: absolute;
    top: var(--space-5);
    right: var(--space-6);
    color: var(--text-3);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-2) var(--space-3);
    z-index: 2;
  }

  .sig-skip:hover {
    color: var(--text-1);
  }
</style>

<script>
  import { registerModule } from '@lib/transitions/vt';
  import { shouldPlayIntro, markIntroSeen } from '@lib/intro/intro-gate';
  import { createSignaturePlayer } from '@lib/intro/signature-player';

  registerModule({
    init() {
      const overlay = document.querySelector<HTMLElement>('[data-sig-overlay]');
      if (!overlay) return;

      if (!shouldPlayIntro()) {
        overlay.remove();
        return;
      }
      markIntroSeen();
      overlay.hidden = false;

      const player = createSignaturePlayer(overlay);
      const skipBtn = overlay.querySelector<HTMLButtonElement>('[data-sig-skip]');
      const enterBtn = overlay.querySelector<HTMLButtonElement>('[data-sig-enter]');

      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape') player.skip();
        if ((e.key === 'Enter' || e.key === ' ') && player.state() === 'complete') {
          player.dismiss();
        }
      };
      const onWheel = () => {
        if (player.state() === 'complete') player.dismiss();
      };
      document.addEventListener('keydown', onKey);
      document.addEventListener('wheel', onWheel, { passive: true });
      document.addEventListener('touchmove', onWheel, { passive: true });
      skipBtn?.addEventListener('click', () => player.skip());
      enterBtn?.addEventListener('click', () => player.dismiss());
      skipBtn?.focus({ preventScroll: true });

      player.onDismissed(() => {
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('wheel', onWheel);
        document.removeEventListener('touchmove', onWheel);
      });

      player.play();

      return () => {
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('wheel', onWheel);
        document.removeEventListener('touchmove', onWheel);
        player.destroy();
      };
    },
  });
</script>
