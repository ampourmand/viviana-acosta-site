---
import Page from '../../layouts/Page.astro';
import SectionHeading from '@components/shared/SectionHeading.astro';
import Bookshelf from '@components/writing/Bookshelf.astro';
---

<Page
  title="Writing"
  description="Picture books, short fiction, and a young adult novel in progress by Viviana Acosta."
>
  <section class="section container shelf-page">
    <SectionHeading eyebrow="Writing" title="Stories for children of all ages" level="h1" />
    <p class="lede prose-width">
      Science and speculative fiction centering people of color and the immigrant diaspora, written
      so that the kids who read them feel safe and seen.
    </p>

    <Bookshelf />

    <p class="bib-link">
      Looking for the full list? <a href="/writing/bibliography">Read the bibliography</a>.
    </p>
  </section>
</Page>

<style>
  /* The shelf is the page: start it high, right under the header. */
  .section.shelf-page {
    padding-block-start: var(--space-7);
  }

  .lede {
    color: var(--text-2);
    font-size: 1.15rem;
    margin-block-end: var(--space-6);
  }

  .bib-link {
    margin-block-start: var(--space-7);
    color: var(--text-2);
  }

  .bib-link a {
    color: var(--accent);
  }
</style>
