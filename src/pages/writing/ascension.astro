---
import { getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Orb from '@components/orbs/Orb.astro';
import EditorialImage from '@components/shared/EditorialImage.astro';
import WorkMeta from '@components/writing/WorkMeta.astro';

import coverAscension from '@assets/photos/cover-ascension.jpg';

const work = await getEntry('works', 'ascension');
if (!work) throw new Error('ascension work entry missing');
const { Content } = await render(work);
---

<Page
  title="Ascension"
  description="Ascension, the work-in-progress debut young adult novel by Viviana Acosta."
>
  <section class="ascension-hero surface-wine">
    <div class="sky" aria-hidden="true"></div>
    <div class="planet">
      <Orb
        preset="planet"
        spin
        label="A dotted planet, the devastated Earth of Ascension. Drag to spin it, or use the arrow keys."
      />
    </div>
    <div class="container hero-copy">
      <p class="eyebrow">Young Adult Novel</p>
      <h1 class="t-6">{work.data.title}</h1>
      <p class="subtitle t-hand">{work.data.subtitle}</p>
    </div>
  </section>

  <section class="section container">
    <div class="logline prose-width t-1">
      <Content />
    </div>
    <WorkMeta work={work.data} />

    <div class="cover-band">
      <EditorialImage
        src={coverAscension}
        alt="Mock cover for Ascension"
        widths={[700, 1200, 1900]}
        sizes="(max-width: 900px) 100vw, 900px"
      />
    </div>
  </section>
</Page>

<style>
  .ascension-hero {
    position: relative;
    z-index: var(--z-base);
    overflow: clip;
    padding-block: var(--space-10) var(--space-9);
  }

  .sky {
    position: absolute;
    inset: -4%;
    background-image: image-set(
      url('/washes/wash-wine.webp') type('image/webp'),
      url('/washes/wash-wine.jpg') type('image/jpeg')
    );
    background-size: cover;
    background-position: center;
  }

  .planet {
    position: absolute;
    top: 50%;
    right: max(-60px, calc((100vw - var(--container)) / 2 - 120px));
    transform: translateY(-50%);
    z-index: 1;
  }

  .hero-copy {
    position: relative;
    pointer-events: none;
  }

  .subtitle {
    color: var(--text-2);
    font-size: 1.35rem;
    margin-block-start: var(--space-3);
  }

  .logline {
    color: var(--text-1);
    margin-block-end: var(--space-6);
  }

  .cover-band {
    margin-block-start: var(--space-7);
    border-radius: 4px;
    overflow: hidden;
    max-width: 900px;
    box-shadow: var(--shadow-rest);
  }

  @media (max-width: 720px) {
    .planet {
      right: -140px;
      opacity: 0.35;
    }
  }
</style>
