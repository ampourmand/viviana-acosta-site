---
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Page from '../layouts/Page.astro';
import SectionHeading from '@components/shared/SectionHeading.astro';
import WorkRow from '@components/writing/WorkRow.astro';
import PostCard from '@components/blog/PostCard.astro';
import BookIntro from '@components/intro/BookIntro.astro';
import Ink from '@components/shared/Ink.astro';
import Print from '@components/shared/Print.astro';
import { site } from '@data/site';
import { bio } from '@data/about';

import headshot from '@assets/photos/portrait-headshot.jpg';
import coverAscension from '@assets/photos/cover-ascension.jpg';
import coverICantSee from '@assets/photos/cover-i-cant-see.jpg';
import coverPanela from '@assets/photos/cover-panela-plantation.jpg';

const covers: Record<string, ImageMetadata> = {
  ascension: coverAscension,
  'i-cant-see': coverICantSee,
  'panela-plantation': coverPanela,
};
const hrefs: Record<string, string> = {
  ascension: '/writing/ascension/',
  'i-cant-see': '/writing/picture-books/',
  'panela-plantation': '/writing/short-fiction/',
};

const works = (await getCollection('works', (w) => w.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = await Promise.all(
  works.map(async (work) => ({ work, rendered: await render(work) })),
);

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = posts[0];
---

<Page>
  <link slot="head" rel="preload" href="/ink/mission.svg" as="image" type="image/svg+xml" />
  <BookIntro slot="overlay" />

  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow" data-hero-reveal>{site.role}</p>
      <h1 class="hero-name t-6" data-hero-reveal>{site.name}</h1>

      <!-- Her mission, in her hand: the line the pen writes in the opening.
           The h1 above names the page; this is the sentence it exists for. -->
      <p class="hero-mission">
        <Ink piece="mission" class="hero-ink" />
      </p>

      <p class="tagline t-1" data-hero-reveal>{site.taglineA}</p>
      <p class="tagline-b eyebrow" data-hero-reveal>{site.taglineB}</p>
      <button class="replay ui" type="button" data-intro-replay data-hero-reveal>
        Replay the opening
      </button>
    </div>

    <div class="hero-portrait" data-hero-reveal>
      <Print
        src={headshot}
        alt="Viviana Acosta, smiling, in a charcoal blazer"
        rotate={2.2}
        tape
        loading="eager"
        sizes="(max-width: 860px) 70vw, 380px"
      />
    </div>
  </section>

  <section class="section container intro-row">
    <p class="t-2 intro-lede">{bio[0]}</p>
    <div class="intro-rest">
      <p class="intro-second">{bio[1]}</p>
      <a class="more ui" href="/about/">More about Viviana</a>
    </div>
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Selected Works" title="Writing" />
    {
      featured.map(({ work, rendered }) => (
        <WorkRow
          title={work.data.title}
          subtitle={work.data.subtitle}
          status={work.data.status}
          href={hrefs[work.id] ?? '/writing/'}
          cover={covers[work.id] ?? null}
          reverse={work.data.category === 'short-fiction'}
        >
          <rendered.Content />
        </WorkRow>
      ))
    }
    <p class="all-writing">
      <a class="more ui" href="/writing/">All writing</a>
    </p>
  </section>

  {
    latest && (
      <section class="section container">
        <SectionHeading eyebrow="From the Blog" title="Notes on the writing life" />
        <PostCard
          title={latest.data.title}
          description={latest.data.description}
          date={latest.data.date}
          href={`/blog/${latest.id}/`}
          cover={latest.data.cover}
        />
        <p class="all-writing">
          <a class="more ui" href="/blog/">All posts</a>
        </p>
      </section>
    )
  }

  <section class="section container causes-strip">
    <SectionHeading eyebrow="Causes" title="Join me in supporting these worthy organizations" />
    <p class="prose-width causes-line">
      The League of Women Voters, the American Civil Liberties Union, and Project Street Vet.
      <a href="/causes/">See why they matter</a>.
    </p>
  </section>
</Page>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-9) var(--space-9);
  }

  .hero-name {
    margin-block: var(--space-3) var(--space-5);
    color: var(--text-1);
  }

  .hero-mission {
    margin-block-end: var(--space-6);
  }

  .hero-ink {
    width: min(36rem, 100%);
    /* Optical alignment: pull the ink's padding out of the text edge. */
    margin-inline-start: -0.55rem;
  }

  .tagline {
    color: var(--text-2);
  }

  .tagline-b {
    margin-block-start: var(--space-3);
  }

  .replay {
    margin-block-start: var(--space-6);
    color: var(--text-3);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-2) 0;
    transition: color var(--dur-quick) var(--ease-out);
  }

  .replay:hover {
    color: var(--accent);
  }

  .hero-portrait {
    justify-self: center;
    width: min(100%, 23rem);
  }

  .intro-row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-8);
    align-items: start;
    border-top: 1px solid var(--line);
    padding-block-start: var(--space-8);
  }

  .intro-lede {
    max-width: 34rem;
  }

  .intro-second {
    color: var(--text-2);
  }

  .more {
    display: inline-block;
    margin-block-start: var(--space-5);
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-block-end: 2px;
  }

  .more:hover {
    color: var(--accent-bright);
    border-color: var(--accent-bright);
  }

  .more + .more {
    margin-inline-start: var(--space-6);
  }

  .causes-line {
    color: var(--text-2);
  }

  .causes-line a {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--space-7);
      padding-block: var(--space-7) var(--space-8);
    }
    .hero-ink {
      margin-inline-start: -0.5rem;
    }
    .hero-portrait {
      justify-self: start;
      width: min(78%, 20rem);
      margin-inline-start: var(--space-3);
    }
    .intro-row {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>

<script>
  import { registerModule } from '@lib/transitions/vt';
  import { requestReplay } from '@lib/intro/intro-gate';

  registerModule({
    init() {
      const btn = document.querySelector<HTMLButtonElement>('[data-intro-replay]');
      if (!btn) return;
      const onClick = () => {
        requestReplay();
        window.location.reload();
      };
      btn.addEventListener('click', onClick);
      return () => btn.removeEventListener('click', onClick);
    },
  });
</script>
