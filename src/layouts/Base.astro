---
import { ClientRouter } from 'astro:transitions';
import { site } from '@data/site';
import '@styles/tokens.css';
import '@styles/base.css';
import '@styles/typography.css';
import '@styles/utilities.css';
import '@styles/prose.css';
import '@styles/transitions.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og-default.png',
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f1ec" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/fraunces-latin-full-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-opsz-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <!-- The book intro decides before first paint, so the home page never
         flashes ahead of its cover. It plays when the home page is where a
         session begins (or on an explicit replay), and never under reduced
         motion. No script, no intro: the site is simply there. -->
    <script is:inline>
      (function () {
        try {
          var s = window.sessionStorage;
          var replay = s.getItem('viv:intro:replay') === '1';
          var fresh = s.getItem('viv:intro:v2') === null;
          var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var home = location.pathname === '/' || location.pathname === '';
          if (home && !calm && (fresh || replay)) {
            document.documentElement.classList.add('intro-on');
            // Failsafe: if the intro script never starts, show the site.
            setTimeout(function () {
              if (!window.__vivIntroStarted) document.documentElement.classList.remove('intro-on');
            }, 5000);
          }
          s.removeItem('viv:intro:replay');
          s.setItem('viv:intro:v2', '1');
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <div class="wash-layer" aria-hidden="true"></div>
    <a class="skip-link ui" href="#main">Skip to content</a>
    <slot />
    <script>
      import { reflectClasses } from '@lib/motion/prefs';
      import '@lib/site/orb-mounts';
      import '@lib/scroll/choreography';
      import '@lib/ink/reveal';
      reflectClasses();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: var(--z-skiplink);
    background: var(--surface-2);
    color: var(--text-1);
    padding: 0.6rem 1rem;
    border-radius: 4px;
    border: 1px solid var(--line-strong);
    transform: translateY(-200%);
    transition: transform var(--dur-quick) var(--ease-out);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
